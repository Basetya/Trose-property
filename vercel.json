{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/img/(.*)",
      "dest": "/frontend/img/$1"
    },
    {
      "src": "^/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "^/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "^/admin/?$",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "^/dashboard/?$",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "^/concierge/?$",
      "dest": "/frontend/concierge.html"
    },
    {
      "src": "^/inspections/?$",
      "dest": "/frontend/inspections.html"
    },
    {
      "src": "^/finance/?$",
      "dest": "/frontend/finance.html"
    },
    {
      "src": "^/units/?$",
      "dest": "/frontend/units.html"
    },
    {
      "src": "^/leases/?$",
      "dest": "/frontend/leases.html"
    },
    {
      "src": "^/billing/?$",
      "dest": "/frontend/billing.html"
    },
    {
      "src": "^/maintenance/?$",
      "dest": "/frontend/maintenance.html"
    },
    {
      "src": "^/crm/?$",
      "dest": "/frontend/crm.html"
    },
    {
      "src": "^/owner-portal/?$",
      "dest": "/frontend/owner-portal.html"
    },
    {
      "src": "^/invoice-view/?$",
      "dest": "/frontend/invoice-view.html"
    },
    {
      "src": "^/(?!frontend/)(.*)\\.html$",
      "dest": "/frontend/$1.html"
    },
    {
      "src": "^/$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "^/(?!frontend/)(.*)$",
      "dest": "/frontend/$1"
    }
  ]
}